# ─────────────────────────────────────────────────────────────────────────────
# .env.example  -  copy to .env and fill in your values
# NEVER commit .env to GitHub (already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (optional - dashboard works without it) ──────────────────────────
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false

# ── SendGrid (optional - for at-risk cohort email export) ────────────────────
# Get free key at: https://sendgrid.com
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM_EMAIL=analytics@yourdomain.com

# ── Data path (optional - skips file uploader) ───────────────────────────────
# DATA_PATH=/absolute/path/to/your/dataset.csv
