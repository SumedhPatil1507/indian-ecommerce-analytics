# ─────────────────────────────────────────────────────────────────────────────
# .env.example  -  copy to .env and fill in your values
# NEVER commit .env to GitHub (already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (optional - dashboard works without it) ──────────────────────────
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false

# Optional OpenTelemetry collector. If unset, spans are recorded by the active
# application provider; the standalone Copilot uses no exporter by default.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional RTO graph model. Set the checkpoint after running scripts/train_rto_gnn.py.
# RTO_GNN_CHECKPOINT=artifacts/rto_gnn.pt
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=replace-me

# ── SendGrid (optional - for at-risk cohort email export) ────────────────────
# Get free key at: https://sendgrid.com
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM_EMAIL=analytics@yourdomain.com

# ── OpenAI (for Merchant Insights Copilot AI-generated answers) ───────────────
# Get from: https://platform.openai.com/api-keys
# Without this key, the Copilot runs in demo mode (raw module summaries)
OPENAI_API_KEY=your_openai_api_key_here

# ── Data path (optional - skips file uploader) ───────────────────────────────
# DATA_PATH=/absolute/path/to/your/dataset.csv
